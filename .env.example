# App
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
# Optional. If set on API, admin endpoints require X-Admin-Token.
# Set the same value for web server-side admin pages/actions.
ADMIN_API_TOKEN=change-this-admin-token

# PostgreSQL
POSTGRES_DB=groceries
POSTGRES_USER=groceries
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://groceries:change-me@postgres:5432/groceries

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Deployment
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Retailer scraper credentials
# Use dedicated test accounts. Do not commit real credentials.
PRICESMART_USERNAME=
PRICESMART_PASSWORD=
JTA_USERNAME=
JTA_PASSWORD=
